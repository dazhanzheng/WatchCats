name: Build

on:
  push:
    branches: [ main ]
    tags:
      - 'v*'
  workflow_dispatch:

jobs:
  build-windows:
    name: Build Windows Application
    runs-on: self-hosted
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        clean: true
        fetch-depth: 0
    
    - name: Setup environment
      shell: powershell
      run: |
        Write-Host "===================================" -ForegroundColor Cyan
        Write-Host " Baal Desktop Pet - Windows Build" -ForegroundColor Cyan
        Write-Host "===================================" -ForegroundColor Cyan
        Write-Host ""
        Write-Host "Runner: $env:COMPUTERNAME" -ForegroundColor Yellow
        Write-Host "Directory: $pwd" -ForegroundColor Yellow
        Write-Host "Time: $(Get-Date)" -ForegroundColor Yellow
        Write-Host "Commit: ${{ github.sha }}" -ForegroundColor Yellow
        Write-Host ""
        
        # 显示 Python 路径和版本
        Write-Host "Python information:" -ForegroundColor Green
        Get-Command python -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source
        python --version
        
        # 清理旧文件
        Write-Host ""
        Write-Host "Cleaning old build files..." -ForegroundColor Green
        @("build", "dist", "venv", "__pycache__", "*.spec.bak") | ForEach-Object {
          if (Test-Path $_) {
            Remove-Item -Path $_ -Recurse -Force -ErrorAction SilentlyContinue
            Write-Host "  - Removed $_" -ForegroundColor Gray
          }
        }
    
    - name: Create and setup virtual environment
      shell: powershell
      run: |
        Write-Host "====================================" -ForegroundColor Cyan
        Write-Host " Setting up Python Environment" -ForegroundColor Cyan
        Write-Host "====================================" -ForegroundColor Cyan
        
        # 先进行诊断
        Write-Host "`nPython diagnostic:" -ForegroundColor Yellow
        try {
          $pythonVersion = python --version 2>&1
          Write-Host "Python version: $pythonVersion" -ForegroundColor Green
        } catch {
          Write-Host "Python command failed: $_" -ForegroundColor Red
        }
        
        # 检查 Python 位置
        $pythonPath = (Get-Command python -ErrorAction SilentlyContinue).Source
        Write-Host "Python path: $pythonPath" -ForegroundColor Cyan
        
        # 清理旧的虚拟环境
        if (Test-Path "venv") {
          Write-Host "`nRemoving existing venv..." -ForegroundColor Yellow
          cmd /c "rmdir /s /q venv" 2>$null
          Start-Sleep -Seconds 2
        }
        
        Write-Host "`nAttempting to create virtual environment..." -ForegroundColor Green
        
        # 方法 1: 直接运行，忽略输出
        Write-Host "Method 1: Direct execution" -ForegroundColor Cyan
        $venvProcess = Start-Process -FilePath "python" -ArgumentList "-m", "venv", "venv" -NoNewWindow -PassThru -Wait
        Write-Host "Process exit code: $($venvProcess.ExitCode)" -ForegroundColor Gray
        
        # 等待并检查
        Start-Sleep -Seconds 5
        
        # 检查是否成功
        $venvPython = "venv\Scripts\python.exe"
        if (Test-Path $venvPython) {
          Write-Host "✓ Virtual environment created!" -ForegroundColor Green
        } else {
          Write-Host "venv\Scripts\python.exe not found after first attempt" -ForegroundColor Yellow
          
          # 方法 2: 使用 virtualenv
          Write-Host "`nMethod 2: Using virtualenv" -ForegroundColor Cyan
          python -m pip install --user virtualenv 2>&1 | Out-Null
          python -m virtualenv venv 2>&1 | Out-Null
          Start-Sleep -Seconds 5
        }
        
        # 最终检查
        if (Test-Path $venvPython) {
          Write-Host "`n✓ SUCCESS: Virtual environment is ready" -ForegroundColor Green
          
          # 测试虚拟环境
          $testVersion = & $venvPython --version 2>&1
          Write-Host "Venv Python: $testVersion" -ForegroundColor Cyan
        } else {
          # 如果还是失败，尝试不使用虚拟环境
          Write-Host "`n⚠ WARNING: Could not create virtual environment" -ForegroundColor Yellow
          Write-Host "Falling back to system Python with --user flag" -ForegroundColor Yellow
          
          # 创建假的 venv 目录结构以满足后续步骤
          New-Item -ItemType Directory -Force -Path "venv\Scripts" | Out-Null
          
          # 创建包装脚本
          $wrapperContent = @'
@echo off
python %*
'@
          Set-Content -Path "venv\Scripts\python.bat" -Value $wrapperContent
          
          $pipWrapperContent = @'
@echo off
python -m pip %*
'@
          Set-Content -Path "venv\Scripts\pip.bat" -Value $pipWrapperContent
          
          # 创建 PowerShell 包装器
          $psWrapperContent = @'
& python $args
'@
          Set-Content -Path "venv\Scripts\python.ps1" -Value $psWrapperContent
          
          $psPipWrapperContent = @'
& python -m pip $args
'@
          Set-Content -Path "venv\Scripts\pip.ps1" -Value $psPipWrapperContent
          
          Write-Host "Created wrapper scripts for fallback mode" -ForegroundColor Green
        }
    
    - name: Install dependencies
      shell: powershell
      run: |
        Write-Host "Installing Python dependencies..." -ForegroundColor Green
        
        # 检测使用哪种 Python（真实虚拟环境或包装脚本）
        $pythonExe = ".\venv\Scripts\python.exe"
        $pipExe = ".\venv\Scripts\pip.exe"
        $pythonBat = ".\venv\Scripts\python.bat"
        $pipBat = ".\venv\Scripts\pip.bat"
        $useWrapper = $false
        
        if (Test-Path $pythonExe) {
          Write-Host "Using virtual environment Python" -ForegroundColor Green
          $pythonCmd = $pythonExe
          $pipCmd = if (Test-Path $pipExe) { $pipExe } else { "$pythonExe -m pip" }
        } elseif (Test-Path $pythonBat) {
          Write-Host "Using wrapper scripts (fallback mode)" -ForegroundColor Yellow
          $pythonCmd = "cmd /c $pythonBat"
          $pipCmd = "cmd /c $pipBat"
          $useWrapper = $true
        } else {
          Write-Host "Using system Python directly" -ForegroundColor Yellow
          $pythonCmd = "python"
          $pipCmd = "python -m pip"
          $useWrapper = $true
        }
        
        try {
          # 升级 pip
          Write-Host "`nUpgrading pip..." -ForegroundColor Yellow
          if ($useWrapper) {
            # 对于包装模式，使用 --user 安装
            Invoke-Expression "$pythonCmd -m pip install --upgrade pip --user --no-warn-script-location" | Out-Host
          } else {
            & $pythonCmd -m pip install --upgrade pip --no-warn-script-location | Out-Host
          }
          
          # 安装 PyInstaller
          Write-Host "`nInstalling PyInstaller..." -ForegroundColor Yellow
          if ($useWrapper) {
            Invoke-Expression "$pipCmd install pyinstaller==6.11.1 --user --no-warn-script-location" | Out-Host
          } else {
            & $pythonCmd -m pip install "pyinstaller==6.11.1" --no-warn-script-location | Out-Host
          }
          
          # 安装项目依赖
          Write-Host "`nInstalling requirements.txt..." -ForegroundColor Yellow
          if ($useWrapper) {
            Invoke-Expression "$pipCmd install -r requirements.txt --user --no-warn-script-location" | Out-Host
          } else {
            & $pythonCmd -m pip install -r requirements.txt --no-warn-script-location | Out-Host
          }
          
          # 显示关键包的版本
          Write-Host "`nKey packages installed:" -ForegroundColor Green
          if ($useWrapper) {
            $packages = Invoke-Expression "$pipCmd list" 2>&1
          } else {
            $packages = & $pythonCmd -m pip list 2>&1
          }
          
          $packages | Select-String -Pattern "PyQt6|pyinstaller|langchain|aw-" | ForEach-Object {
            Write-Host "  - $_" -ForegroundColor Gray
          }
          
          Write-Host "`n✓ All dependencies installed successfully" -ForegroundColor Green
          
        } catch {
          Write-Error "Failed to install dependencies: $_"
          exit 1
        }
    
    - name: Build with PyInstaller
      shell: powershell
      run: |
        Write-Host "Building Windows executable..." -ForegroundColor Green
        
        # 确定 spec 文件
        $specFile = if (Test-Path "baal_windows.spec") {
          "baal_windows.spec"
        } elseif (Test-Path "baal.spec") {
          "baal.spec"
        } else {
          Write-Error "No spec file found!"
          Write-Host "Available spec files:" -ForegroundColor Yellow
          Get-ChildItem *.spec -ErrorAction SilentlyContinue | ForEach-Object { Write-Host "  - $($_.Name)" -ForegroundColor Gray }
          exit 1
        }
        
        Write-Host "Using spec file: $specFile" -ForegroundColor Yellow
        
        # 查找 PyInstaller
        $pyinstallerExe = ".\venv\Scripts\pyinstaller.exe"
        $pyinstallerScript = ".\venv\Scripts\pyinstaller-script.py"
        $pyinstallerCmd = $null
        
        if (Test-Path $pyinstallerExe) {
          Write-Host "Using virtual environment PyInstaller" -ForegroundColor Green
          $pyinstallerCmd = $pyinstallerExe
        } else {
          # 尝试使用系统 PyInstaller（--user 安装）
          Write-Host "Looking for PyInstaller in user path..." -ForegroundColor Yellow
          
          # 检查用户脚本目录
          $userScriptsPath = "$env:APPDATA\Python\Python*\Scripts"
          $userPyInstaller = Get-ChildItem -Path $userScriptsPath -Filter "pyinstaller.exe" -ErrorAction SilentlyContinue | Select-Object -First 1
          
          if ($userPyInstaller) {
            Write-Host "Found PyInstaller at: $($userPyInstaller.FullName)" -ForegroundColor Green
            $pyinstallerCmd = $userPyInstaller.FullName
          } else {
            # 尝试通过 Python 模块运行
            Write-Host "Running PyInstaller as Python module" -ForegroundColor Yellow
            $pyinstallerCmd = "python -m PyInstaller"
          }
        }
        
        # 清理缓存和旧构建
        Write-Host "`nCleaning build directories..." -ForegroundColor Yellow
        @("build", "dist", "$env:APPDATA\pyinstaller", "$env:LOCALAPPDATA\pyinstaller") | ForEach-Object {
          if ($_ -and (Test-Path $_)) {
            try {
              Remove-Item -Path $_ -Recurse -Force -ErrorAction Stop
              Write-Host "  Cleaned: $_" -ForegroundColor Gray
            } catch {
              Write-Host "  Could not clean: $_ (may be in use)" -ForegroundColor Gray
            }
          }
        }
        
        try {
          # 运行 PyInstaller
          Write-Host "`nBuilding executable..." -ForegroundColor Cyan
          
          if ($pyinstallerCmd -like "python*") {
            # 作为 Python 模块运行
            Write-Host "Command: $pyinstallerCmd --clean --noconfirm $specFile" -ForegroundColor Gray
            $output = Invoke-Expression "$pyinstallerCmd --clean --noconfirm $specFile" 2>&1
          } else {
            # 直接运行可执行文件
            Write-Host "Command: $pyinstallerCmd --clean --noconfirm $specFile" -ForegroundColor Gray
            $output = & $pyinstallerCmd --clean --noconfirm $specFile 2>&1
          }
          
          $output | ForEach-Object { Write-Host $_ }
          
          # 检查是否成功（检查 dist 目录）
          Start-Sleep -Seconds 3
          if (Test-Path "dist\*.exe") {
            Write-Host "`n✓ PyInstaller build completed successfully!" -ForegroundColor Green
          } else {
            throw "No executable found in dist directory"
          }
          
        } catch {
          Write-Error "PyInstaller build failed: $_"
          
          # 显示详细错误信息
          Write-Host "`nError details:" -ForegroundColor Yellow
          Write-Host $_.Exception.Message -ForegroundColor Red
          
          # 检查 build 目录的日志
          $buildLogs = Get-ChildItem "build" -Filter "*.txt" -ErrorAction SilentlyContinue
          if ($buildLogs) {
            Write-Host "`nBuild log files found:" -ForegroundColor Yellow
            foreach ($log in $buildLogs) {
              Write-Host "  - $($log.Name)" -ForegroundColor Gray
              Get-Content $log.FullName -Tail 20 -ErrorAction SilentlyContinue | ForEach-Object {
                Write-Host "    $_" -ForegroundColor DarkGray
              }
            }
          }
          
          exit 1
        }
        
        # 验证构建结果
        Write-Host ""
        Write-Host "Checking build output..." -ForegroundColor Yellow
        
        if (-not (Test-Path "dist")) {
          Write-Error "dist directory not found!"
          Write-Host "Current directory contents:" -ForegroundColor Yellow
          Get-ChildItem | Select-Object Name, Mode | Format-Table -AutoSize
          exit 1
        }
        
        $exeFiles = Get-ChildItem -Path "dist" -Filter "*.exe" -ErrorAction SilentlyContinue
        
        if ($exeFiles -and $exeFiles.Count -gt 0) {
          Write-Host "✓ Build successful!" -ForegroundColor Green
          Write-Host ""
          Write-Host "Executable files:" -ForegroundColor Green
          foreach ($exe in $exeFiles) {
            $sizeMB = [math]::Round($exe.Length / 1MB, 2)
            Write-Host "  - $($exe.Name) ($sizeMB MB)" -ForegroundColor Cyan
            
            # 获取文件版本信息（不运行 exe）
            try {
              $fileVersion = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($exe.FullName)
              if ($fileVersion.FileVersion) {
                Write-Host "    File Version: $($fileVersion.FileVersion)" -ForegroundColor Gray
              }
              if ($fileVersion.ProductName) {
                Write-Host "    Product Name: $($fileVersion.ProductName)" -ForegroundColor Gray
              }
            } catch {
              # 忽略版本信息获取失败
            }
          }
          
          # 验证主要的 exe 文件
          $mainExe = $exeFiles | Where-Object { $_.Name -like "*Baal*" -or $_.Name -like "*宠物*" } | Select-Object -First 1
          if (-not $mainExe) {
            $mainExe = $exeFiles[0]
          }
          Write-Host "`nMain executable: $($mainExe.Name)" -ForegroundColor Cyan
          
        } else {
          Write-Error "No executable files found in dist folder"
          
          # 显示 dist 目录内容用于调试
          Write-Host "dist directory contents:" -ForegroundColor Yellow
          Get-ChildItem -Path "dist" -Recurse -ErrorAction SilentlyContinue | 
            Select-Object FullName, Length, Extension | 
            Format-Table -AutoSize
          
          exit 1
        }
    
    - name: Create installer
      shell: powershell
      continue-on-error: true  # 允许失败，因为可能没有安装 Inno Setup
      run: |
        Write-Host "Looking for Inno Setup..." -ForegroundColor Green
        
        # 查找 Inno Setup
        $innoSetupPaths = @(
          "C:\Program Files (x86)\Inno Setup 6\ISCC.exe",
          "C:\Program Files\Inno Setup 6\ISCC.exe",
          "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe",
          "${env:ProgramFiles}\Inno Setup 6\ISCC.exe",
          "D:\InnoSetup\ISCC.exe"  # 自定义路径
        )
        
        $iscc = $null
        foreach ($path in $innoSetupPaths) {
          if (Test-Path $path) {
            $iscc = $path
            Write-Host "Found Inno Setup at: $iscc" -ForegroundColor Green
            break
          }
        }
        
        if ($iscc) {
          # 检查安装脚本
          $issFile = "installer\windows\baal_setup.iss"
          
          if (Test-Path $issFile) {
            Write-Host "Creating installer..." -ForegroundColor Yellow
            & $iscc /Q $issFile
            
            # 检查输出
            $installerExe = Get-ChildItem -Path "installer\windows\Output\*.exe" -ErrorAction SilentlyContinue
            if ($installerExe) {
              Write-Host "✓ Installer created successfully!" -ForegroundColor Green
              foreach ($exe in $installerExe) {
                $sizeMB = [math]::Round($exe.Length / 1MB, 2)
                Write-Host "  - $($exe.Name) ($sizeMB MB)" -ForegroundColor Cyan
              }
            }
          } else {
            Write-Host "Installer script not found at: $issFile" -ForegroundColor Yellow
          }
        } else {
          Write-Host "Inno Setup not installed" -ForegroundColor Yellow
          Write-Host "Download from: https://jrsoftware.org/isdl.php" -ForegroundColor Gray
        }
    
    - name: Package artifacts
      shell: powershell
      run: |
        Write-Host "Packaging build artifacts..." -ForegroundColor Green
        
        # 创建 artifacts 目录
        New-Item -ItemType Directory -Force -Path artifacts | Out-Null
        
        # 复制所有可执行文件
        $exeCount = 0
        Get-ChildItem -Path "dist" -Filter "*.exe" -ErrorAction SilentlyContinue | ForEach-Object {
          $destPath = Join-Path "artifacts" $_.Name
          Copy-Item -Path $_.FullName -Destination $destPath -Force
          if (Test-Path $destPath) {
            $exeCount++
            Write-Host "  - Copied: $($_.Name)" -ForegroundColor Gray
          }
        }
        
        # 复制安装程序（如果存在）
        $installerPath = "installer\windows\Output"
        if (Test-Path $installerPath) {
          Get-ChildItem -Path "$installerPath\*.exe" -ErrorAction SilentlyContinue | ForEach-Object {
            $destPath = Join-Path "artifacts" "Setup-$($_.Name)"
            Copy-Item -Path $_.FullName -Destination $destPath -Force
            Write-Host "  - Copied installer: $($_.Name)" -ForegroundColor Gray
          }
        }
        
        # 获取版本信息
        $version = "latest"
        $refName = "${{ github.ref }}"
        if ($refName -match "refs/tags/v(.+)") {
          $version = $matches[1]
        } elseif ("${{ github.run_number }}") {
          $version = "build-${{ github.run_number }}"
        }
        
        Write-Host "Version: $version" -ForegroundColor Yellow
        
        # 创建 ZIP 包
        $zipName = "BaalDesktopPet-Windows-${version}.zip"
        Write-Host "Creating ZIP archive: $zipName" -ForegroundColor Yellow
        
        try {
          # 使用 .NET 方法创建 ZIP
          Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
          $compressionLevel = [System.IO.Compression.CompressionLevel]::Optimal
          $zipPath = [System.IO.Path]::Combine($pwd, "artifacts", $zipName)
          $sourcePath = [System.IO.Path]::Combine($pwd, "dist")
          
          if (Test-Path $sourcePath) {
            [System.IO.Compression.ZipFile]::CreateFromDirectory($sourcePath, $zipPath, $compressionLevel, $false)
            Write-Host "✓ ZIP created successfully" -ForegroundColor Green
          } else {
            Write-Warning "Source directory not found: $sourcePath"
          }
        } catch {
          Write-Warning "Failed to create ZIP: $_"
          Write-Host "Attempting alternative ZIP method..." -ForegroundColor Yellow
          
          # 备用方法：使用 PowerShell 的 Compress-Archive
          try {
            Compress-Archive -Path "dist\*" -DestinationPath "artifacts\$zipName" -Force
            Write-Host "✓ ZIP created using Compress-Archive" -ForegroundColor Green
          } catch {
            Write-Warning "Alternative ZIP method also failed: $_"
          }
        }
        
        # 显示最终的 artifacts
        Write-Host ""
        Write-Host "Final artifacts:" -ForegroundColor Green
        Get-ChildItem "artifacts" -ErrorAction SilentlyContinue | ForEach-Object {
          $sizeMB = [math]::Round($_.Length / 1MB, 2)
          $sizeKB = [math]::Round($_.Length / 1KB, 2)
          if ($sizeMB -ge 1) {
            Write-Host "  - $($_.Name) ($sizeMB MB)" -ForegroundColor Cyan
          } else {
            Write-Host "  - $($_.Name) ($sizeKB KB)" -ForegroundColor Cyan
          }
        }
        
        # 验证至少有一个文件
        $artifactCount = (Get-ChildItem "artifacts" -ErrorAction SilentlyContinue).Count
        if ($artifactCount -eq 0) {
          Write-Error "No artifacts were created!"
          exit 1
        }
        
        Write-Host "`nTotal artifacts: $artifactCount" -ForegroundColor Green
    
    - name: Upload build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: windows-build-${{ github.run_number }}
        path: artifacts/
        retention-days: 30
        if-no-files-found: error
    
    - name: Create Release
      if: startsWith(github.ref, 'refs/tags/v')
      uses: softprops/action-gh-release@v2
      with:
        draft: false
        prerelease: false
        name: Release ${{ github.ref_name }}
        tag_name: ${{ github.ref_name }}
        body: |
          # Baal Desktop Pet ${{ github.ref_name }}
          
          ## 📦 下载
          
          - **Windows 安装程序**: `BaalDesktopPetSetup.exe`（推荐）
          - **Windows 便携版**: `BaalDesktopPet-Windows-${{ github.ref_name }}.zip`
          
          ## 📝 更新内容
          
          请查看提交历史了解详细更新内容。
          
          ## 🛠 系统要求
          
          - Windows 10/11
          - Python 3.9+ （如果使用源代码）
          
          ---
          *Built on self-hosted runner: ${{ runner.name }}*
          *Build #${{ github.run_number }}*
        files: |
          artifacts/*.zip
          artifacts/*.exe
        fail_on_unmatched_files: false
        generate_release_notes: true
    
    - name: Cleanup workspace
      if: always()
      shell: powershell
      run: |
        Write-Host "Cleaning up workspace..." -ForegroundColor Green
        
        # 清理构建相关文件
        $itemsToClean = @(
          "venv",
          "build", 
          "dist",
          "__pycache__",
          "*.spec.bak",
          ".pytest_cache",
          "*.pyc",
          "*.pyo"
        )
        
        foreach ($item in $itemsToClean) {
          Get-ChildItem -Path $item -Recurse -Force -ErrorAction SilentlyContinue | ForEach-Object {
            Remove-Item -Path $_.FullName -Recurse -Force -ErrorAction SilentlyContinue
          }
          
          if (Test-Path $item) {
            Remove-Item -Path $item -Recurse -Force -ErrorAction SilentlyContinue
            Write-Host "  - Cleaned: $item" -ForegroundColor Gray
          }
        }
        
        # 清理 PyInstaller 缓存
        if ($env:APPDATA) {
          $pyinstallerCache = "$env:APPDATA\pyinstaller"
          if (Test-Path $pyinstallerCache) {
            Remove-Item -Path $pyinstallerCache -Recurse -Force -ErrorAction SilentlyContinue
            Write-Host "  - Cleaned PyInstaller cache" -ForegroundColor Gray
          }
        }
        
        Write-Host "Workspace cleanup completed" -ForegroundColor Green